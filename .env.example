# Optional overrides for scripts. Paths may be absolute or repository-relative.
DATASET_ARCHIVE=zavod70-20260801T082255Z-1-001.zip
DATASET_NAME=zavod70
PREPARED_WIDTH=1280
CAPTURE_FPS=1
SMOKE_FRAMES=20

# low-vram is the reproducible default for the 5.64 GiB RTX 4050 target.
# Alternatives: pose-only (minimum VRAM), quality (large-memory GPU).
VIPE_PROFILE=low-vram

# Splatfacto full-run limits verified for the 5.64 GiB RTX 4050 target.
SPLAT_FULL_STOP_SPLIT_AT=6000
SPLAT_VIEWER_RAYS_PER_CHUNK=8192
PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

# Conda environment names. Defaults are pinned in configs/versions.env.
VIPE_ENV_NAME=vipe
NERFSTUDIO_ENV_NAME=nerfstudio
